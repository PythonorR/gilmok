# ---------------------------------------------------------------------------
# Backend (services/api) — server-side only. Never expose these to the browser.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://gilmok:gilmok@localhost:5432/gilmok

# Demo mode: serve clearly labeled synthetic data when real data is not loaded.
DEMO_MODE=true

# Allowed browser origins for CORS (comma-separated).
CORS_ORIGINS=http://localhost:3000

# Public data portal (data.go.kr) service key — SEMAS store information API.
# Obtain: data.go.kr > sign up > dataset 15012005 > "활용신청". Use the *decoded* key.
DATA_GO_KR_SERVICE_KEY=

# Seoul Open Data Plaza key — trade-area (상권) metrics, living population.
# Obtain: data.seoul.go.kr > sign up > "인증키 신청".
SEOUL_OPEN_API_KEY=

# Kakao REST API key — used only by the server-side search proxy (/api/locations/search).
# Obtain: developers.kakao.com > My Application > App Keys.
KAKAO_REST_API_KEY=

# Request limits
MAX_BBOX_AREA_KM2=100
CACHE_TTL_SECONDS=86400

# ---------------------------------------------------------------------------
# Frontend (apps/web) — NEXT_PUBLIC_* values are visible to the browser.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# Kakao JavaScript key. Register your site domain(s) under
# My Application > Platform > Web, or the map will not load.
NEXT_PUBLIC_KAKAO_JS_KEY=
